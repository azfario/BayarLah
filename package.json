{
  "name": "bayarlah",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:demo": "node scripts/dev-demo.mjs",
    "build": "next build --turbopack",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:setup": "node scripts/setup-db.mjs",
    "db:add-whatsapp-inbound": "node scripts/setup-db.mjs supabase/migrations/20260607_add_whatsapp_inbound_idempotency.sql",
    "db:cleanup-legacy": "node scripts/setup-db.mjs supabase/migrations/20260607_remove_legacy_user_whatsapp.sql",
    "lint": "eslint",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker",
    "typecheck:app": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions --skipLibCheck workers/whatsapp/worker.ts",
    "test": "node --test --experimental-strip-types tests/payment-proofs.test.mjs tests/payment-proof-matching.test.mjs tests/payment-proof-inbound.test.mjs tests/whatsapp-reminder.test.mjs tests/whatsapp-inbound.test.mjs tests/profile.test.mjs tests/whatsapp-bot.test.mjs",
    "test:payment-proofs": "npm test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "docker:worker": "docker compose -f docker-compose.worker.yml up --build",
    "docker:novacloud": "docker compose --env-file .env.novacloud -f docker-compose.novacloud.yml up -d --build",
    "whatsapp:worker": "npm --prefix workers/whatsapp run start"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.5",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.105.1",
    "next": "15.5.19",
    "react": "19.1.8",
    "react-dom": "19.1.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.19",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
